new file mode 100644
index 0000000..68c2d52
--- /dev/null
+++ b/baselines/native/trace_pipeline.hpp
@@ -0,0 +1,107 @@
+// Three reusable immutable lifecycle buffers; dispatcher stays outside Arrow pool.
+// Only the worker calls writer callbacks; no Arrow views survive a callback.
+#pragma once
+#include "engine.hpp"
+#include <condition_variable>
+#include <deque>
+#include <exception>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+
+namespace t3 {
+inline void clear_trace(TraceColumns& m) {
+  m.t_ns.clear(); m.agent_id.clear(); m.msg_type.clear(); m.side.clear();
+  m.price.clear(); m.size.clear(); m.order_id.clear();
+}
+class TracePipeline final : public TraceSink {
+ public:
+  using Write = std::function<void(const TraceColumns&, size_t)>;
+  TracePipeline(Write write, std::function<void()> close,
+                std::function<void()> simulation_finished = [] {})
+      : write_(std::move(write)), close_(std::move(close)),
+        simulation_finished_(std::move(simulation_finished)) {
+    free_.push_back(std::make_unique<TraceColumns>());
+    free_.push_back(std::make_unique<TraceColumns>());
+    worker_ = std::thread([this] { consume(); });
+  }
+  TracePipeline(const TracePipeline&) = delete;
+  TracePipeline& operator=(const TracePipeline&) = delete;
+  ~TracePipeline() { cancel(); }
+
+  void submit(TraceColumns& block) override {
+    std::unique_lock<std::mutex> lock(mutex_);
+    changed_.wait(lock, [this] { return error_ || stopped_ || !free_.empty(); });
+    if (error_) std::rethrow_exception(error_);
+    if (stopped_) throw std::runtime_error("trace pipeline already stopped");
+    auto buffer = std::move(free_.back());
+    free_.pop_back();
+    std::swap(*buffer, block);
+    pending_.push_back(std::move(buffer));
+    changed_.notify_all();
+  }
+  void simulation_finished() override { simulation_finished_(); }
+  void finish() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stopped_ = true;
+    }
+    changed_.notify_all();
+    if (worker_.joinable()) worker_.join();
+    if (error_) std::rethrow_exception(error_);
+  }
+  void cancel() noexcept {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      cancelled_ = stopped_ = true;
+    }
+    changed_.notify_all();
+    if (worker_.joinable()) worker_.join();
+  }
+ private:
+  void consume() noexcept {
+    try {
+      size_t offset = 0;
+      for (;;) {
+        std::unique_ptr<TraceColumns> block;
+        {
+          std::unique_lock<std::mutex> lock(mutex_);
+          changed_.wait(lock, [this] { return stopped_ || !pending_.empty(); });
+          if (cancelled_) return;
+          if (pending_.empty()) break;
+          block = std::move(pending_.front());
+          pending_.pop_front();
+        }
+        write_(*block, offset);
+        offset += block->t_ns.size();
+        clear_trace(*block);
+        {
+          std::lock_guard<std::mutex> lock(mutex_);
+          free_.push_back(std::move(block));
+        }
+        changed_.notify_all();
+      }
+      close_();
+    } catch (...) {
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        error_ = std::current_exception();
+        stopped_ = true;
+      }
+      changed_.notify_all();
+    }
+  }
+  Write write_;
+  std::function<void()> close_, simulation_finished_;
+  std::mutex mutex_;
+  std::condition_variable changed_;
+  std::vector<std::unique_ptr<TraceColumns>> free_;
+  std::deque<std::unique_ptr<TraceColumns>> pending_;
+  bool stopped_ = false, cancelled_ = false;
+  std::exception_ptr error_;
+  std::thread worker_;
+};
+}  // namespace t3
