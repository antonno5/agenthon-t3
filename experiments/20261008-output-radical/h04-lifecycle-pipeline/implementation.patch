+// reach this code: their definition levels are all 1 and repetition levels absent.
+struct TraceParquetWriter::Impl {
+  std::shared_ptr<arrow::io::FileOutputStream> sink;
+  std::shared_ptr<parquet::ArrowWriterProperties> aprops = arrow_properties();
+  std::unique_ptr<parquet::ParquetFileWriter> writer;
+  parquet::RowGroupWriter* group = nullptr;
+  size_t rows = 0;
+  bool partial = false, closed = false;
