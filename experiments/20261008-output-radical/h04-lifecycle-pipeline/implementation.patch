+    }
+    std::vector<int16_t> definitions(static_cast<size_t>(n), 1);
+    check(arrow::internal::ParallelFor(7, [&](int i) {
+      if ((immutable && i == 2) || (types_only && i != 2)) return arrow::Status::OK();
+      auto array = arrays[i]->Slice(offset, n);
