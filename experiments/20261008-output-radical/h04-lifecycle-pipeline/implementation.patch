+  explicit Impl(const std::string& path) {
+    auto schema = trace_schema();
+    auto props = writer_properties();
+    std::shared_ptr<parquet::SchemaDescriptor> descriptor;
+    check(parquet::arrow::ToParquetSchema(schema.get(), *props, *aprops, &descriptor));
+    // Exactly FileWriter::Open's stored Arrow schema and metadata encounter order.
+    auto metadata = schema->metadata()->Copy();
+    auto serialized = value(arrow::ipc::SerializeSchema(*schema, arrow::default_memory_pool()));
+    metadata->Append("ARROW:schema", arrow::util::base64_encode(serialized->ToString()));
+    sink = value(arrow::io::FileOutputStream::Open(path));
+    writer = parquet::ParquetFileWriter::Open(
