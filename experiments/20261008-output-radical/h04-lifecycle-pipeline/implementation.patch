+        block_.t_ns.push_back(r.t);
+        block_.agent_id.push_back(r.agent);
+        block_.side.push_back(r.side);
+        block_.price.push_back(r.price);
+        block_.size.push_back(r.size);
+        block_.order_id.push_back(r.oid);
+        if (block_.t_ns.size() == kTraceBlockRows) sink_->submit(block_);
+      }
     }
     pending_.clear();
   }
