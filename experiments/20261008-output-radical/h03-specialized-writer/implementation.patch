+struct FixedFile {
+  std::shared_ptr<arrow::io::FileOutputStream> sink;
+  std::unique_ptr<parquet::ParquetFileWriter> writer;
+  parquet::RowGroupWriter* group = nullptr;
+  explicit FixedFile(const std::string& path, const std::shared_ptr<arrow::Schema>& schema) {
+    parquet::WriterProperties::Builder p;
+    p.version(parquet::ParquetVersion::PARQUET_2_6);
+    p.data_page_version(parquet::ParquetDataPageVersion::V1);
+    p.compression(parquet::Compression::SNAPPY);
+    p.enable_dictionary(); p.enable_statistics();
+    p.max_row_group_length(64 * 1024 * 1024);
+    p.disable_page_checksum(); p.disable_write_page_index();
+    auto props = p.build();
+    parquet::ArrowWriterProperties::Builder a;
+    a.store_schema(); a.enable_compliant_nested_types();
+    std::shared_ptr<parquet::SchemaDescriptor> descriptor;
+    check(parquet::arrow::ToParquetSchema(schema.get(), *props, *a.build(), &descriptor));
+    auto metadata = schema->metadata()->Copy();
+    auto serialized = value(arrow::ipc::SerializeSchema(*schema));
+    metadata->Append("ARROW:schema", arrow::util::base64_encode(serialized->ToString()));
+    sink = value(arrow::io::FileOutputStream::Open(path));
+    writer = parquet::ParquetFileWriter::Open(sink,
+      std::static_pointer_cast<parquet::schema::GroupNode>(descriptor->schema_root()), props, metadata);
+  }
+  void new_group() { group = writer->AppendBufferedRowGroup(); }
+  void close() { writer->Close(); check(sink->Close()); }
