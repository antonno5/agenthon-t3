+template <typename Writer, typename T>
+void numbers(parquet::ColumnWriter* column, const T* data, size_t n,
+             const uint8_t* nulls = nullptr) {
+  auto* writer = static_cast<Writer*>(column);
+  std::array<int16_t, kBatch> levels;
+  levels.fill(1);
+  std::array<T, kBatch> compact;
+  for (size_t begin = 0; begin < n; begin += kBatch) {
+    const size_t count = std::min(kBatch, n - begin);
+    if (!nulls) { writer->WriteBatch(count, levels.data(), nullptr, data + begin); continue; }
+    size_t valid = 0;
+    for (size_t j = 0; j < count; ++j) {
+      levels[j] = nulls[begin + j] ? 0 : 1;
+      if (levels[j]) compact[valid++] = data[begin + j];
+    }
+    writer->WriteBatch(count, levels.data(), nullptr, compact.data());
+  }
 }
