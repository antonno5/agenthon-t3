+class _HeapQueue:
+    """Single-threaded drop-in for ``queue.PriorityQueue``.
+
+    ``PriorityQueue`` is itself a ``heapq`` over ``self.queue`` guarded by a lock and two
+    condition variables; the kernel is single-threaded, so the locking is pure overhead.
+    Same heap, same tuple comparisons, therefore the exact same pop order.
+    """
+
+    __slots__ = ("queue",)
+
+    def __init__(self) -> None:
+        self.queue: list = []
+
+    def put(self, item) -> None:
+        heappush(self.queue, item)
+
+    def get(self):
+        return heappop(self.queue)
+
+    def empty(self) -> bool:
+        return not self.queue
+
+    def qsize(self) -> int:
+        return len(self.queue)
+
